# =============================================================
# client-onboarding-tool — environment variable reference
# =============================================================
# This file lists every env var the application code reads, with
# placeholder/blank values only — NEVER commit real secrets here.
# Real values live in the project's Vercel Environment Variables.
#
# Secrets (anything ending in _TOKEN, _KEY, _SECRET, plus
# SHARED_INTEGRATION_BEARER_TOKEN) belong on the Production scope
# in Vercel.
#
# Grouped by integration. Each var has a one-line comment on what
# it's for. Generated from a process.env grep of the codebase under
# src/; doc-only references (RAPIDAPI_KEY, NEXT_PUBLIC_SITE_URL,
# PLAYWRIGHT_VERCEL_SHARE_TOKEN — mentioned only in audit docs and
# the playwright-harness-plan) are excluded.

# =============================================================
# Supabase (the onboarding tool's primary backing store)
# =============================================================
# Public URL of the Supabase project.
# LIVE project (use this): https://gmvdmgcueveuedhkucsh.supabase.co
# DEAD project (NEVER use): lawwsutjxopiekjzupef — decommissioned;
# its hostname no longer resolves (DNS ENOTFOUND). Pointing here
# silently breaks every read/write.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to ship to the browser. Used by the
# client-side Supabase JS (src/lib/supabase/client.ts) for any
# RLS-gated reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only. Used by every server route that
# writes onboarding_sessions, clients, onboarding_audit_events, etc.
# Treat as the keys-to-the-kingdom secret; never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================
# Admin auth (/admin gate + admin onboarding endpoints)
# =============================================================
# Plaintext password compared by /api/admin/auth POST.
ADMIN_PASSWORD=
# Long random string (>=32 chars), HMAC key for the admin session cookie.
ADMIN_SESSION_SECRET=

# =============================================================
# Cross-repo integration (onboarding <-> dashboard/workbook)
# =============================================================
# Bearer shared by BOTH directions of the integration:
#   - the dashboard/workbook sends it when calling onboarding's
#     bearer-gated admin routes (e.g. /api/admin/onboarding/create),
#     validated at the perimeter by src/proxy.ts; and
#   - onboarding sends it when calling the dashboard's
#     POST /api/clients on submit (src/lib/onboarding/dashboard-bridge.ts).
# Must match the same-named var on the dashboard repo. Rotate both
# in lockstep.
SHARED_INTEGRATION_BEARER_TOKEN=
# Base URL of the dashboard app the onboarding->dashboard client
# bridge POSTs to on a successful submit. Bearer-authed, so it must
# be the canonical origin (a redirect would strip the auth header).
# Defaults to https://workbooks.clixsy.co when unset.
DASHBOARD_BASE_URL=

# =============================================================
# Google Sheet roster export (fires on submit, next to the bridge)
# =============================================================
# Service-account credentials for the Sheets API write
# (src/lib/onboarding/sheet-export.ts). CLIENT_EMAIL unset = the
# export is a logged no-op (local/dev). The private key is stored
# with literal \n escapes; the code unescapes at use.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
# Spreadsheet id of the client-roster sheet the export appends to.
EXPORT_SHEET_ID=

# =============================================================
# PIN-cookie security (client onboarding session auth)
# =============================================================
# Long random string (>=32 chars). HMAC key for the signed PIN cookie
# that proves the client has entered the correct PIN. Rotating this
# logs every client out of any in-progress session.
PIN_COOKIE_SECRET=

# =============================================================
# PIN plaintext retrieval (admin re-reads an existing PIN)
# =============================================================
# AES-256-GCM key for the reversible copy of each session's PIN
# (src/lib/onboarding/pin-encryption.ts). Exactly 32 bytes, base64.
# Generate with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Must be canonical base64 (standard alphabet, padding included) or
# the app refuses to start using it: base64url or a truncated paste
# would decode to a different 32-byte key and silently orphan every
# row already written.
#
# LOSING OR ROTATING THIS KEY makes every stored copy unreadable.
# It does NOT lock anybody out: pin_hash is the verification path and
# is unaffected, so clients keep signing in with the PINs they have.
# Sessions written under the old key simply fall back to "PIN cannot
# be shown, regenerate it" in the admin UI.
#
# Unset is NOT confined to the retrieval endpoint. encryptPin loads
# the key too, so with this unset every session creation and every PIN
# rotation still succeeds but stores no recoverable copy: those rows
# become "PIN cannot be shown, regenerate it" for good, until the key
# is set and the PIN is rotated again. Nothing 500s and nothing locks
# out, which is the fail-open decision working as intended, but it is
# not a no-op.
#
# HOW TO TELL A DEPLOYMENT HAS A WORKING KEY
# There is no boot-time assertion, on purpose. Next.js has no single
# startup hook that can fail a deployment, and a module that threw on
# import would take unrelated routes down with it: that turns a
# convenience feature into an outage, which is the opposite of the
# fail-open decision in src/lib/onboarding/pin-envelope-write.ts.
# Instead, every write-time failure lands in the database, so the
# check is a query rather than a log search. Run POST-APPLY CHECK 5 in
# supabase/migrations/011_pin_envelope.sql after any deploy and after
# any change to this variable: rows there mean the deployment minted
# PINs it can never show again. CHECK 3 in the same file is the
# positive version (newest sessions carry an envelope).
#
# Two things detect it without anyone running a query, and they are
# the reason a boot assertion is not worth its cost here:
#
#   1. The retrieval endpoint answers 503 configuration fault, not
#      "not recoverable", the first time anyone reads a PIN on a
#      deployment whose key is unset. An operator is told the key is
#      missing instead of being sent to regenerate, which cannot work
#      while the key is still missing.
#   2. Every write-time failure writes a pin_envelope_write_failed
#      audit row (create path) or a pin_encryption_error_code on the
#      pin_rotated row (rotation path), so the blast radius is
#      countable after the fact instead of being lost to log
#      retention.
#
# A boot-time assertion would also buy less here than it looks:
# there is no DATABASE_URL on this project, only PostgREST, so a
# startup probe has nothing cheap to talk to, and a health-check
# route would need its own auth gate to avoid becoming an unauth'd
# config oracle.
PIN_ENCRYPTION_KEY=

# =============================================================
# Site intelligence — opt-in prefill feature (analyze on step 1)
# =============================================================
# Set to "true" to enable the analyze-on-step-1 flow. Unset/false
# hides the AnalyzePanel and skips prefill entirely.
ENABLE_SITE_INTELLIGENCE_PREFILL=

# At least one analyzer key must be set for site intelligence to
# return useful data. Each is independent; the analyzer runs all
# configured providers in parallel and merges results.

# Firecrawl — page extraction (content, contact_public, key_pages).
# Required for the usable-content predicate to pass on real sites.
FIRECRAWL_API_KEY=

# Google PageSpeed Insights — Core Web Vitals + performance signals.
PAGESPEED_API_KEY=

# Wappalyzer — tech-stack detection. Optional.
WAPPALYZER_API_KEY=

# BuiltWith — alternative tech-stack signal. Optional.
BUILTWITH_API_KEY=

# =============================================================
# Google Business Profile API (GBP location sync)
# =============================================================
# All three OAuth vars stay UNSET until the Business Profile API
# access application is approved + a one-time consent mints the
# refresh token. With all three present the client runs in "real"
# mode; otherwise it falls back to a mock client (see
# src/lib/gbp/config.ts). No code change needed to flip — set the
# vars + redeploy.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=
# Optional override: "mock" forces the mock client, "real" forces
# the real client (and fails loudly if creds are missing). Unset =
# auto-detect from the three vars above.
GBP_API_MODE=

# =============================================================
# Test-only flags (leave UNSET in real environments)
# =============================================================
# When "true", /api/public/onboarding/submit short-circuits the
# real submit side effects for integration tests. MUST stay unset
# in production/preview — setting it disables real submissions.
ONBOARDING_SUBMIT_TEST_MODE=
